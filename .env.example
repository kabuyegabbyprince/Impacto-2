# Impacto Platform Environment Configuration
# Copy this file to .env and provide your production or development values.

# Port for Express server (defaults to 3000 in dev and container environment)
PORT=3000
NODE_ENV=development

# Google Gemini API Key for Server-Side AI (Executive summaries, ledger insights, message drafting)
GEMINI_API_KEY=

# Supabase Realtime Database & Storage Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# pawaPay Push-to-Pay Mobile Money Integration
PAWAPAY_API_TOKEN=
PAWAPAY_PROD=false
